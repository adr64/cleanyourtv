<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted rows to match Home pills: soft glass, bright focus, quiet selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#22FFFFFF"
                android:startColor="#44FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#14FFFFFF"
                android:startColor="#2AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
