<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted plate behind the screensaver clock: readable over any wallpaper, no GPU blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#A61A1E28"
        android:endColor="#CC10141C" />
    <stroke
        android:width="1dp"
        android:color="#55FFFFFF" />
    <corners android:radius="28dp" />
</shape>
