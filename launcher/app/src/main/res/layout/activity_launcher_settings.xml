<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080B10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_light"
            android:letterSpacing="0.02"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/launcher_settings_subtitle"
            android:textColor="#99A8B8C8"
            android:textSize="14sp" />

        <!-- Appearance: theme + wallpaper first (what people look for) -->
        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="30dp"
            android:text="@string/settings_section_look" />

        <TextView
            android:id="@+id/themeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/theme_hint"
            android:textColor="#88A8B8C8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/homeWallpaperRotationChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeWallpaperImagesChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clockWallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/clockWallpaperRotationChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clockWallpaperImagesChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeIdleChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/greetingNameChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/greeting_name_hint"
            android:textColor="#88A8B8C8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/follow_theme_hint"
            android:textColor="#88A8B8C8"
            android:textSize="13sp" />

        <!-- Layout -->
        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="28dp"
            android:text="@string/settings_section_layout" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@string/font_medium"
            android:text="@string/columns_label"
            android:textColor="#CCD0D7DE"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@string/font_medium"
            android:text="@string/rows_below_dock_label"
            android:textColor="#CCD0D7DE"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@string/font_medium"
            android:text="@string/dock_opacity_label"
            android:textColor="#CCD0D7DE"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@string/font_medium"
            android:text="@string/clock_format_label"
            android:textColor="#CCD0D7DE"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
            <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
            <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
        </LinearLayout>

        <!-- Motion -->
        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="28dp"
            android:text="@string/settings_section_motion" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/advanced_effects_warning"
            android:textColor="#88A8B8C8"
            android:textSize="13sp" />

        <!-- System -->
        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="28dp"
            android:text="@string/settings_section_system" />

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@string/font_regular"
            android:text="@string/home_settings_help"
            android:textColor="#88A8B8C8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
