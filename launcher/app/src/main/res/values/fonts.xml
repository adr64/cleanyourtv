    <string name="font_body" translatable="false">@font/sst_regular</string>
    <string name="font_regular" translatable="false">@font/sst_regular</string>
    <string name="font_light" translatable="false">@font/sst_light</string>
    <string name="font_extralight" translatable="false">@font/sst_light</string>
    <string name="font_medium" translatable="false">@font/sst_medium</string>
</resources>
